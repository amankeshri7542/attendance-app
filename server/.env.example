# Server Environment Variables
# Copy this file to .env and fill in your values

MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key
PORT=5001

# Office Location for Geofencing (latitude, longitude)
# Change these coordinates to your office/shop location
OFFICE_LAT=25.5864201
OFFICE_LNG=85.1294782

# Production: URL of the deployed frontend (for CORS)
# Example: https://attendance.vercel.app
FRONTEND_URL=

# Set to 'production' on Render/deployment
NODE_ENV=development
